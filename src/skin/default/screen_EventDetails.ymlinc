screen:
  name: "EventDetails"
  position: "center,center"
  size: "1416,858"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        alphatest: "on"
        name: "picon"
        position: "20,70"
        scale: "1"
        scaleFlags: "scaleCenter"
        size: "100,100"
    - widget:
        font: "$md_title_large"
        name: "title"
        position: "150,70"
        size: "826,43"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$md_body_large"
        name: "subtitle"
        position: "150,125"
        size: "826,37"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$md_body_large"
        name: "duration"
        position: "150,170"
        size: "300,37"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$md_body_large"
        name: "description"
        position: "20,230"
        size: "956,555"
        transparent: "1"
    - widget:
        alphatest: "blend"
        cornerRadius: "$radius_poster"
        name: "programpix"
        position: "996,70"
        scaleFlags: "scaleCenter"
        size: "400,300"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
