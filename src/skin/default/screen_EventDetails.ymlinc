screen:
  backgroundColor: "md_transparent"
  name: "EventDetails"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Wide.ymlinc"
        position: "252,111"
    - widget:
        alphatest: "on"
        name: "picon"
        position: "30,85"
        scale: "1"
        scaleFlags: "scaleCenter"
        size: "100,100"
    - widget:
        font: "$md_title_large"
        name: "title"
        position: "160,85"
        size: "800,43"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$md_body_large"
        name: "subtitle"
        position: "160,138"
        size: "800,37"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$md_body_large"
        name: "duration"
        position: "160,185"
        size: "300,37"
        transparent: "1"
        valign: "center"
        zPosition: "1"
    - widget:
        font: "$md_body_large"
        name: "description"
        position: "30,250"
        size: "930,490"
        transparent: "1"
    - widget:
        alphatest: "blend"
        cornerRadius: "$radius_poster"
        name: "programpix"
        position: "986,85"
        scaleFlags: "scaleCenter"
        size: "400,300"
