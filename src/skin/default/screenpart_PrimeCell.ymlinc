# Picon
- widget:
    alphatest: "blend"
    name: "picon$index"
    position: "5,65"
    scaleFlags: "scaleCenter"
    size: "80,50"

# event poster
- widget:
    alphatest: "blend"
    cornerRadius: "$radius_poster"
    name: "programpix$index"
    position: "115,65"
    scaleFlags: "scaleCenter"
    size: "196,132"

# channel name
- widget:
    font: "$md_label_medium"
    foregroundColor: "md_key_yellow"
    name: "channel$index"
    position: "5,115"
    size: "110,55"
    transparent: "1"
    valign: "center"

# event start time    
- widget:
    font: "$md_label_medium"
    foregroundColor: "md_key_yellow"
    name: "time$index"
    position: "5,170"
    size: "110,30"
    transparent: "1"
    valign: "bottom"

# event description
- widget:
    font: "$md_title_medium_emphasized"
    foregroundColor: "md_key_yellow"
    name: "description$index"
    position: "5,210"
    size: "306,55"
    transparent: "1"
