convert:
  type: "TemplatedMultiContentEx"
  cell:
    itemHeight: 150
    width: 320
    selectionEnabled: false
    border:
      width: 1
      color: "md_outline_variant"
      font: "$caption_font"
      flags: RT_VALIGN_CENTER
    fonts:
      - "$event_font"
      - "$caption_font"
      - "$info_font"
    fields:
      - text:
          position: "5,5"
          size: "55,25"
          font: "$caption_font"
          flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
          value: 0
      - text:
          position: "5,32"
          size: "55,20"
          font: "$info_font"
          flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
          value: 9
      - text:
          position: "65,5"
          size: "245,75"
          font: "$event_font"
          flags: RT_HALIGN_LEFT|RT_WRAP
          value: 1
      - text:
          position: "65,90"
          size: "245,25"
          font: "$caption_font"
          flags: RT_HALIGN_LEFT
          value: 2
          color: "md_on_surface_variant"
          color_sel: "md_on_surface_variant"
      - text:
          position: "65,118"
          size: "245,25"
          font: "$caption_font"
          flags: RT_HALIGN_LEFT|RT_WRAP
          value: 3
          color: "md_on_surface_variant"
          color_sel: "md_on_surface_variant"
