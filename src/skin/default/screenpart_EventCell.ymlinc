convert:
  type: "COCTemplatedMultiContentEx"
  cell:
    itemHeight: 141
    width: 316
    selectionEnabled: false
    border:
      width: 1
      color: "md_outline_variant"
      font: "$md_label_medium"
      flags: RT_VALIGN_CENTER
    fonts:
      - "$md_title_medium_emphasized"
      - "$md_label_medium"
      - "$md_title_small_emphasized"
    fields:
      - text:
          position: "5,5"
          size: "55,25"
          font: "$md_label_medium"
          flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
          value: 0
      - text:
          position: "5,32"
          size: "55,20"
          font: "$md_title_small_emphasized"
          flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
          value: 9
      - text:
          position: "65,5"
          size: "245,75"
          font: "$md_title_medium_emphasized"
          flags: RT_HALIGN_LEFT|RT_WRAP
          value: 1
      - text:
          position: "65,90"
          size: "245,25"
          font: "$md_label_medium"
          flags: RT_HALIGN_LEFT
          value: 2
          color: "md_on_surface_variant"
          color_sel: "md_on_surface_variant"
      - text:
          position: "65,114"
          size: "245,25"
          font: "$md_label_medium"
          flags: RT_HALIGN_LEFT|RT_WRAP
          value: 3
          color: "md_on_surface_variant"
          color_sel: "md_on_surface_variant"
