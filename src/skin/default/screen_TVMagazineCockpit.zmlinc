screen:
  backgroundColor: "md_transparent"
  name: "TVMagazineCockpit"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - widget:
        font: "$md_label_medium"
        halign: "right"
        name: "day_selector"
        position: "1280,22"
        size: "420,30"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - for:
        var: "$i"
        range: [0, 5]
        body:
          - xmlinc:
              file: "screenpart_PrimeCell.ymlinc"
              index: "$i"
              position: "eval(8+$i*316),17"
    - for:
        var: "$i"
        range: [0, 5]
        body:
          - widget:
              backgroundColorSelected: "$backgroundColorSelected"
              enableWrapAround: "1"
              foregroundColorSelected: "$foregroundColorSelected"
              itemCornerRadiusSelected: "$radius_item"
              position: "eval(8+$i*316),288"
              render: "Listbox"
              scrollbarMode: "showNever"
              size: "316,705"
              source: "list$i"
              transparent: "1"
              children:
                - xmlinc:
                    file: "screenpart_EventCell.ymlinc"
