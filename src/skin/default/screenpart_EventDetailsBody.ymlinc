- widget:
    alphatest: "on"
    name: "picon"
    position: "0,0"
    scale: "1"
    scaleFlags: "scaleCenter"
    size: "100,100"
- widget:
    font: "$md_title_large"
    name: "title"
    position: "130,0"
    size: "$width-560,43"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- widget:
    font: "$md_body_large"
    name: "subtitle"
    position: "130,53"
    size: "$width-560,37"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- widget:
    font: "$md_body_large"
    name: "duration"
    position: "130,100"
    size: "300,37"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- widget:
    font: "$md_body_large"
    name: "description"
    position: "0,174"
    size: "$width-434,$height-174"
    transparent: "1"
- widget:
    alphatest: "blend"
    cornerRadius: "$radius_poster"
    name: "programpix"
    position: "$width-400,0"
    scaleFlags: "scaleCenter"
    size: "400,300"
