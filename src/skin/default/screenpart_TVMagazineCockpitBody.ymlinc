- xmlinc:
    file: "screenpart_PrimeCell.ymlinc"
    index: "0"
    position: "eval(0*$width/6),0"
- xmlinc:
    file: "screenpart_PrimeCell.ymlinc"
    index: "1"
    position: "eval(1*$width/6),0"
- xmlinc:
    file: "screenpart_PrimeCell.ymlinc"
    index: "2"
