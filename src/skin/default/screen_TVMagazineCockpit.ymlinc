screen:
  backgroundColor: "md_transparent"
  name: "TVMagazineCockpit"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - widget:
        font: "$md_label_medium"
        halign: "right"
        name: "day_selector"
        position: "1280,2"
        size: "420,$window_header_height-2"
        transparent: "1"
        valign: "center"
        zPosition: "21"
    - xmlinc:
        file: "screenpart_TVMagazineCockpitBody.ymlinc"
        position: "$window_full_body_x,$window_full_body_y"
        size: "$window_full_body_width,$window_full_body_height"
