screen:
  backgroundColor: "md_transparent"
  name: "TVMagazineCockpit"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - widget:
        font: "$md_label_medium"
        halign: "right"
        name: "day_selector"
        position: "1280,22"
        size: "420,30"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "0"
        position: "8+0*316,17"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "1"
        position: "8+1*316,17"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "2"
        position: "8+2*316,17"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "3"
        position: "8+3*316,17"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "4"
        position: "8+4*316,17"
    - xmlinc:
        file: "screenpart_PrimeCell.ymlinc"
        index: "5"
        position: "8+5*316,17"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "8+0*316,288"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "316,705"
        source: "list0"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "8+1*316,288"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "316,705"
        source: "list1"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "8+2*316,288"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "316,705"
        source: "list2"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "8+3*316,288"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "316,705"
        source: "list3"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "8+4*316,288"
        render: "Listbox"
        scrollbarMode: "showNever"
        size: "316,705"
        source: "list4"
        transparent: "1"
        children:
          - xmlinc:
              file: "screenpart_EventCell.ymlinc"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "8+5*316,288"
        render: "Listbox"
